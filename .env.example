#aws services
AWS_ACCESS_KEY_ID = "your_aws_access_key_id"
AWS_SECRET_ACCESS_KEY = "your_aws_secret_access_key"
AWS_REGION = "us-east-1"
your_s3_bucket_name = "your_s3_bucket_name"

#bedrock+titan
BEDROCK_EMBED_MODEL =  "amazon.titan-embed-text-v2:0"
BEDROCK_CHAT_MODEL = "amazon.nova-lite-v1:0"
EMBED_DIMENSION = 1024

#pinecone vector database configuration
PINECONE_API_KEY = "your_pinecone_api_key"
PINECONE_INDEX_NAME = "veritas--rag-index"
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
PINECONE_READY_TIMEOUT=180

#postgreSQL database configuration - render cloud
POSTGRES_DATABASE_URL = "your_postgresql_database_url"

#RIUS observability configuration
RIUS_API_KEY = "your_rius_api_key"
RIUS_SERVICE_NAME = "your_rius_service_name"
RIUS_DISABLED = false
RIUS_CAPTURE_CONTENT =  false
